# Example environment variables for twitter-sentiment-analysis
# Copy to a file named `.env` and fill values before running.

# Twitter API v2 Bearer Token (for real streaming)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Kafka bootstrap servers (used by producer and Spark consumer)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka topic for tweets
KAFKA_TOPIC=twitter-stream

# TCP socket host/port (used for quick local demo mode)
TCP_HOST=localhost
TCP_PORT=9999

# Spark settings (optional)
SPARK_APP_NAME=TwitterSentimentAnalysis
